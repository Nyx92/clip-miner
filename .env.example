# Folder with the episodes. File names must contain SxxEyy, e.g. The.Devil's.Plan.S01E08.mp4
INPUT_DIR=/mnt/c/Users/you/videos
# Clips, key_moments.xlsx and per-episode cache go here
OUTPUT_DIR=/mnt/c/Users/you/videos/output

# 1 = use a .srt next to the video when present, 0 = always OCR the burned-in subtitles
USE_SRT=1
# OCR samples per second, and GPU (1) or CPU (0)
OCR_FPS=2
OCR_USE_CUDA=1

# Clip length range in seconds. A shorter moment is extended, a longer one trimmed, around its middle
CLIP_MIN_SEC=30
CLIP_MAX_SEC=120

# Claude Code CLI, logged in with your Claude subscription (run `claude` once and /login)
CLAUDE_BIN=claude
CLAUDE_MODEL=sonnet
# Optional: your own rubric instead of ./prompt.md
# PROMPT_FILE=/path/to/prompt.md
